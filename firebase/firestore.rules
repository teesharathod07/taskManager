rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{parent}/tasks/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /{path=**}/tasks/{document} {
      allow read: if true;
    }

  }
}
